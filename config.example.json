{
  "bind": "0.0.0.0",
  "port": 6090,
  "display": ":0",
  "files_root": "~",
  "cdp_ports": [
    9222
  ],
  "chrome_bin": "",
  "chrome_profile": "~/.config/swiv/chrome",
  "shell": "",
  "desk_card": true,
  "app_cards": true,
  "app_exclude": [
    "chrom",
    "gnome-terminal",
    "gnome-shell",
    "@!"
  ],
  "app_max_nodes": 400,
  "cert": "",
  "key": "",
  "idle_restore_sec": 20,
  "session_days": 7,
  "auth": "pam",
  "pam_service": "login",
  "pam_dir": "/etc/pam.d",
  "login_max_failures": 5,
  "login_global_max_failures": 20,
  "login_window_min": 15,
  "login_lockout_min": 10,
  "allowed_countries": [],
  "wallpaper_width": 1440,
  "agent": {
    "enabled": false,
    "base_url": "",
    "api_key": "",
    "model": "",
    "max_tokens": 2048,
    "temperature": 0.3,
    "allow_commands": [
      "ls",
      "cat",
      "head",
      "tail",
      "grep",
      "find",
      "df",
      "du",
      "ps",
      "uname",
      "uptime",
      "pwd",
      "which",
      "git status",
      "git log",
      "git diff",
      "git show"
    ],
    "block_commands": [
      "sudo",
      "doas",
      "pkexec",
      "su",
      "mkfs",
      "fdisk",
      "sfdisk",
      "parted",
      "wipefs",
      "shred",
      "dd",
      "shutdown",
      "reboot",
      "halt",
      "poweroff",
      "init",
      "systemctl",
      "rm",
      "chmod",
      "chown",
      "chattr",
      "mv",
      "kill",
      "killall",
      "pkill",
      "crontab",
      "passwd",
      "userdel",
      "usermod"
    ],
    "approval_timeout_sec": 120,
    "shell_timeout_sec": 60,
    "daily_token_budget": 0,
    "rules_path": "~/.config/swiv/agent-rules.md",
    "schedule": [],
    "coach": {
      "enabled": false,
      "nodes_path": "~/.cache/opencode-usage-coach/shared/nodes.ndjson",
      "rules_path": "~/.cache/opencode-usage-coach/projects/d75b58a64b6c/rules.md",
      "max_chars": 6000
    }
  }
}
